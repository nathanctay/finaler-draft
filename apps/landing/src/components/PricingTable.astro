---
import { PRICE_MONTHLY, PRICE_ANNUAL, APP_ORIGIN, APP_LINK_LABEL } from '../site.config.ts';
import { formatPricePerInterval } from '../lib/money.ts';

const monthly = formatPricePerInterval(PRICE_MONTHLY);
const annual = formatPricePerInterval(PRICE_ANNUAL);
---

<section id="pricing" class="pricing" aria-labelledby="pricing-heading">
  <h2 id="pricing-heading">Pricing</h2>
  <p class="pricing-intro">Start free. Upgrade when one screenplay isn't enough.</p>
  <div class="pricing-grid">
    <article class="plan-card" aria-labelledby="plan-free-heading">
      <h3 id="plan-free-heading">Free</h3>
      <p class="plan-price">$0</p>
      <ul>
        <li>
          One fully editable screenplay — the complete authoring toolkit, not a limited preview
        </li>
        <li>Export to PDF, Final Draft (FDX), and Word (DOCX)</li>
        <li>
          Collaborate on a screenplay shared with you — it becomes your one editable screenplay
        </li>
      </ul>
    </article>
    <article class="plan-card plan-card-pro" aria-labelledby="plan-pro-heading">
      <h3 id="plan-pro-heading">Pro</h3>
      <p class="plan-price">{monthly} <span class="plan-price-or">or</span> {annual}</p>
      <p class="plan-price-note">Plus applicable tax, added at checkout.</p>
      <ul>
        <li>Everything in Free</li>
        <li>Unlimited editable screenplays</li>
      </ul>
      <a class="button button-primary" href={APP_ORIGIN}>{APP_LINK_LABEL} to upgrade</a>
    </article>
  </div>
</section>
