# The origin of the deployed app (the `app.` subdomain). Every "Sign in" link on this static
# site points here. Defaults to the web app's local dev server if unset.
PUBLIC_APP_ORIGIN=http://localhost:5173

# This site's own canonical origin, used for <link rel="canonical"> and OpenGraph URLs. Defaults
# to Astro's local dev server if unset.
PUBLIC_SITE_URL=http://localhost:4321
