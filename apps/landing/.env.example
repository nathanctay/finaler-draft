# The origin of the deployed app (the `app.` subdomain). Every link to the app on this static
# site points here, when PUBLIC_APP_IS_LIVE (below) is true. Defaults to the web app's local dev
# server if unset.
PUBLIC_APP_ORIGIN=http://localhost:5173

# Whether the app at PUBLIC_APP_ORIGIN is actually live. This site is meant to deploy before the
# app does (it exists to give Stripe a URL), so this defaults to false: unset or any value other
# than "true"/"1" means every link to the app is omitted or replaced with honest "not live yet"
# copy instead of a link that goes nowhere. Set to "true" once the app is actually deployed.
PUBLIC_APP_IS_LIVE=false

# This site's own canonical origin, used for <link rel="canonical"> and OpenGraph URLs. Defaults
# to Astro's local dev server if unset.
PUBLIC_SITE_URL=http://localhost:4321
