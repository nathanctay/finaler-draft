# Server port. The web client proxies /api to this address during local development.
PORT=3001
# apps/collab's (the Hocuspocus collaboration server) own port. A separate variable from PORT
# above is required locally: `pnpm dev` starts apps/api, apps/web, and apps/collab in parallel,
# all loading this same file, so if apps/collab read PORT too it would collide with apps/api's
# and whichever process bound second would fail with EADDRINUSE. Not needed in production --
# Railway assigns apps/collab its own PORT directly, which always wins (see
# apps/collab/src/environment.ts's `resolveCollabPort`) -- and not read by apps/api, which never
# looks at this variable. 4400 (packages/config's DEFAULT_COLLAB_DEV_PORT) is also the default
# apps/collab falls back to with no `.env` at all, so this line is documentation more than
# requirement; change it only if 4400 collides with something else on your machine. (The web
# client's own VITE_COLLAB_WS_URL, which points it at this server, is not read from this file --
# Vite reads apps/web's own env, not the repo root -- and needs no configuration here either:
# apps/web/src/collabConfig.ts defaults it to the same DEFAULT_COLLAB_DEV_PORT for `pnpm dev`
# specifically. See that file's own doc comment before setting VITE_COLLAB_WS_URL anywhere.)
COLLAB_PORT=4400
# Use production only behind HTTPS and with a dedicated public app origin.
NODE_ENV=development
# PostgreSQL connection used by Better Auth and screenplay persistence.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finaler_draft
# Generate a unique secret with at least 32 characters; never reuse this example value.
BETTER_AUTH_SECRET=
# The public origin Better Auth uses to issue secure same-origin sessions.
BETTER_AUTH_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:5173
# Resend API key, used to send password-reset and email-verification mail. Optional in
# development: leave unset and the server logs the message it would have sent instead of
# delivering it, so the flow stays testable offline. Required in production -- the server refuses
# to start without it, because a production process that can't send these two emails has no
# account-recovery path at all (plan.md, "Launch readiness").
RESEND_API_KEY=
# The From address Resend sends as; must be on a domain verified with Resend.
MAIL_FROM_ADDRESS=
