{
  "name": "@finaler-draft/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "node ./scripts/run-drizzle.mjs generate",
    "db:migrate": "node ./scripts/run-drizzle.mjs migrate",
    "db:studio": "node ./scripts/run-drizzle.mjs studio"
  },
  "dependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "3.2.4",
    "vitest": "3.2.4"
  }
}
