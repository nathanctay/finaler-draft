{
  "name": "@finaler-draft/screenplay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "default": "./dist/fixtures.js"
    },
    "./pageFormat": {
      "types": "./dist/pageFormat.d.ts",
      "default": "./dist/pageFormat.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "vitest": "3.2.4"
  }
}
