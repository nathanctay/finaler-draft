<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<FinalDraft DocumentType="Script" Template="No" Version="6">
  <Content>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="47d6d8ea-cdbc-4244-8732-e4d51f1e9ed0">
      <Text># Server port again I am doing a thing. The web client proxies /api to this address during local development.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="31b9ef69-58f2-407d-9fab-0c4807cd6094">
      <Text>PORT=3001</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="7f32b083-eba3-40ef-bb6d-16f9398a0de9">
      <Text># Use production only behind HTTPS and with a dedicated public app origin.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="3185574b-c02f-41da-b074-9f9cdf677251">
      <Text>NODE_ENV=development</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="af79f528-67cb-4923-a645-4552db3404be">
      <Text># PostgreSQL connection used by Better Auth and screenplay persistence.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="e5a34ab8-cd26-4f81-945d-f2b484658570">
      <Text>DATABASE_URL=postgresql://postgres:password@localhost:5432/finaler_draft</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="a5ef76af-953c-4a5f-a98b-7dbfbcfffe99">
      <Text># Generate a unique secret with at least 32 characters; never reuse this example value.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="3c43092d-394b-43dc-bd75-bba294182271">
      <Text>BETTER_AUTH_SECRET=wAl67wDxAToOX84EmU0aBq7HXKILE/SkXAH111VjPzs=</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="8ef20243-78d5-4493-b5ed-c5ff10f8f29f">
      <Text># The public origin Better Auth uses to issue secure same-origin sessions.</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="e8b9c85a-8ac6-4eaf-814e-846785ff2a3d">
      <Text>BETTER_AUTH_URL=http://localhost:3001</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="3.10" Type="Parenthetical" id="423a6ae2-fb7f-496e-b1d0-92af668274bb">
      <Text>(CLIENT_ORIGIN=http://localhost:5173)</Text>
    </Paragraph>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="6e1c505d-e3b4-4f92-9100-422ef17872c1"/>
    <Paragraph Alignment="Left" LeftIndent="1.50" Type="Action" id="dba541b6-ec3f-4a99-bbe4-54cd6cba1183">
